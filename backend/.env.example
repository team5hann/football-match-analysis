# PostgreSQL connection
DATABASE_URL=postgresql+psycopg2://football:football@localhost:5432/football_analysis

# Where uploaded videos are stored on disk
VIDEO_STORAGE_DIR=./storage/videos

# Max upload size in bytes (default 5 GB)
MAX_UPLOAD_SIZE_BYTES=5368709120

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Path to ffprobe/ffmpeg binaries (leave as-is if on PATH)
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
